<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Doticca.Mnemosyne" Version="$(MnemosynePackageVersion)" />
  </ItemGroup>
  <Target Name="RequirePackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(MnemosynePackageVersion)' == ''" Text="Run scripts/verify.ps1 to test the freshly packed package." />
  </Target>
</Project>