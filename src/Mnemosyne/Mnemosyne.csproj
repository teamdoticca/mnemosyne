<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mnemosyne</RootNamespace>
    <AssemblyName>Mnemosyne</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>Mnemosyne.public.snk</AssemblyOriginatorKeyFile>
    <Description>Deterministic Markdown document structure, classification, link diagnostics, and snapshot differences. No filesystem, Git, database, or UI dependencies.</Description>
    <PackageId>Doticca.Mnemosyne</PackageId>
    <Version>0.1.5</Version>
    <Authors>Doticca SRL</Authors>
    <Company>Doticca SRL</Company>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/teamdoticca/mnemosyne</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teamdoticca/mnemosyne</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.3</PackageValidationBaselineVersion>
    <PackageTags>markdown;language;parser;semantics;links;doticca</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
